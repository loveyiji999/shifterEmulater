      "visual_cues": "土色、輪轍、裂隙、含水及沖蝕痕",
      "geometry_guidance": "土壤含水與車轍分開；深轍須有接觸幾何，不自動成為可變形地形",
      "sources": [
        "UNPAVED-CPY"
      ],
      "status": "preliminary",
      "engineering_basis": "see_source_scope",
      "physics_profile": null,
      "pbr_parameters": null
    },
    {
      "id": "timber",
