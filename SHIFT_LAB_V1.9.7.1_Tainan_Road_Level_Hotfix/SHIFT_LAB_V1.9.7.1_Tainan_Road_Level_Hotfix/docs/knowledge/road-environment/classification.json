      "name": "森林",
      "elements": "喬木、灌木、林緣、枯枝與地被",
      "placement_rule": "按坡向與水分分群；路口視線、護欄及路肩退讓",
      "sources": [
        "TERRAIN-FHWA",
        "VEG-FHWA",
        "WATER-EPA"
      ],
      "status": "project_design_not_implemented"
    },
    {
      "id": "river_valley",
      "name": "河谷",
      "elements": "河床、岸坡、護岸、涵洞、橋台",
      "placement_rule": "水面須在河槽內；橋墩與流水方向協調",
      "sources": [
        "TERRAIN-FHWA",
        "VEG-FHWA",
        "WATER-EPA"
      ],
      "status": "project_design_not_implemented"
    },
    {
      "id": "farmland",
      "name": "農田鄉間",
      "elements": "田埂、灌排溝渠、植栽帶、小型聚落",
      "placement_rule": "田區不能穿入車道；溝渠出口具連續流向",
      "sources": [
        "TERRAIN-FHWA",
        "VEG-FHWA",
        "WATER-EPA"
      ],
      "status": "project_design_not_implemented"
    },
    {
      "id": "suburban",
      "name": "郊區聚落",
      "elements": "住宅、圍牆、路邊草地、出入口",
      "placement_rule": "建物沿地塊或支路生成；避免門口直接接護欄",
      "sources": [
        "TERRAIN-FHWA",
        "VEG-FHWA",
        "WATER-EPA"
      ],
      "status": "project_design_not_implemented"
    },
    {
      "id": "town",
      "name": "城鎮街道",
      "elements": "人行道、路緣、排水口、店面、街燈",
      "placement_rule": "保留行車面與路口平台；外觀建物不預設室內",
      "sources": [
        "TERRAIN-FHWA",
        "VEG-FHWA",
        "WATER-EPA"
      ],
      "status": "project_design_not_implemented"
    },
    {
      "id": "industrial",
      "name": "工業區",
      "elements": "廠房、倉庫、圍籬、裝卸區與寬入口",
      "placement_rule": "圍籬不封死支路；材質老化應有排水與使用原因",
      "sources": [
        "TERRAIN-FHWA",
        "VEG-FHWA",
        "WATER-EPA"
      ],
      "status": "project_design_not_implemented"
    },
    {
      "id": "coastal",
      "name": "海岸",
      "elements": "海岸線、岩岸或沙灘、海堤、耐鹽植栽",
      "placement_rule": "海水不可沿山坡上爬；岸型先選定再配置物件",
      "sources": [
        "TERRAIN-FHWA",
        "VEG-FHWA",
        "WATER-EPA"
      ],
      "status": "project_design_not_implemented"
    },
    {
      "id": "arid",
      "name": "乾燥沙石地",
      "elements": "沙石、裸岩、稀疏灌木、風蝕形態",
      "placement_rule": "沙地外觀不等於車輛已支援陷沙；不要均勻撒樹",
      "sources": [
        "TERRAIN-FHWA",
        "VEG-FHWA",
        "WATER-EPA"
      ],
      "status": "project_design_not_implemented"
    },
    {
      "id": "winter",
      "name": "寒地雪景",
      "elements": "積雪覆蓋、除雪痕、裸露輪跡、稀疏植被",
      "placement_rule": "積雪是覆蓋與狀態；路肩雪堆與行車雪面分開",
