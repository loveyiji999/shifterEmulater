      "visual_cues": "木紋、板縫、磨耗與保護層",
      "geometry_guidance": "木橋不必是木路面；實際磨耗層和結構材質分開",
      "sources": [
        "TIMBER-USFS"
      ],
      "status": "preliminary",
      "engineering_basis": "see_source_scope",
      "physics_profile": null,
      "pbr_parameters": null
    },
    {
