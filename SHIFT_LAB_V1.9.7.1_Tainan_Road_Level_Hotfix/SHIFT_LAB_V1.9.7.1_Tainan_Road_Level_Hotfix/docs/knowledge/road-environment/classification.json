      "status": "preliminary",
      "engineering_basis": "see_source_scope",
      "physics_profile": null,
      "pbr_parameters": null
    },
    {
      "id": "clay_paver",
      "name": "黏土鋪面磚",
      "visual_cues": "燒製色差、鋪砌方向、磚縫",
      "geometry_guidance": "與混凝土磚分開；交通用途及鋪砌層次需確認",
      "sources": [
        "BRICK-BIA"
      ],
      "status": "preliminary",
      "engineering_basis": "see_source_scope",
      "physics_profile": null,
      "pbr_parameters": null
    },
    {
      "id": "natural_stone",
      "name": "天然石材鋪面",
      "visual_cues": "石材種類、加工面、拼縫與不規則磨耗",
      "geometry_guidance": "外觀先列型錄；可行車適用性與止滑資料另補，暫不配置性能",
      "sources": [
        "PBR-THREE"
      ],
      "status": "preliminary",
      "engineering_basis": "pending",
      "physics_profile": null,
      "pbr_parameters": null
    },
    {
      "id": "gravel",
      "name": "碎石路",
      "visual_cues": "粗細料、壓實輪跡、鬆散路肩與粉塵",
      "geometry_guidance": "主承載面連續；少量石塊作獨立障礙，不能以全車道球體堆砌代替路床",
      "sources": [
        "UNPAVED-CPY"
      ],
      "status": "preliminary",
      "engineering_basis": "see_source_scope",
      "physics_profile": null,
      "pbr_parameters": null
