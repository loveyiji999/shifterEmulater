+"""Actual Chromium+Rapier+WebGL smoke/acceptance check (requires npm install + npm run dev).
+
+Usage: python desktop3d/tests/browser_v187.py --url http://127.0.0.1:5173/
+
+Returns nonzero on launch/scene/QA failures. This is a REAL runtime browser test,
+unlike source-only checks. JSON and screenshot output are kept under desktop3d/tests/artifacts.
+"""
+import argparse,json,sys,time
+from pathlib import Path
+from playwright.sync_api import sync_playwright
+
+def main():
+    ap=argparse.ArgumentParser()
+    ap.add_argument('--url',default='http://127.0.0.1:5173/')
+    ap.add_argument('--browser',default='/usr/bin/chromium',help='Chromium executable, empty for Playwright bundled version')
+    ap.add_argument('--timeout',type=int,default=180000)
+    args=ap.parse_args()
+    out=Path(__file__).resolve().parent/'artifacts';out.mkdir(exist_ok=True)
+    errors=[]
+    with sync_playwright() as p:
+        options={'headless':True,'args':['--no-sandbox','--use-gl=angle','--use-angle=swiftshader','--enable-webgl','--enable-unsafe-swiftshader']}
+        if args.browser and Path(args.browser).is_file():options['executable_path']=args.browser
+        browser=p.chromium.launch(**options)
+        page=browser.new_page(viewport={'width':1600,'height':920})
+        page.on('pageerror',lambda error:errors.append(str(error)))
+        try:
+            page.goto(args.url,wait_until='domcontentloaded',timeout=30000)
+            page.wait_for_function("window.__SHIFT_LAB_3D_QA__?.ready===true",timeout=30000)
+            report=page.evaluate('async()=>await window.__SHIFT_LAB_3D_QA__.runSuite()')
+            (out/'v187_browser_report.json').write_text(json.dumps(report,indent=2,ensure_ascii=False))
+            page.screenshot(path=str(out/'v187_browser_screenshot.png'),full_page=False)
+            for item in report:
+                print(('PASS' if item['pass'] else 'FAIL')+' '+item['scenario'],
+                      {k:round(v,3) if isinstance(v,float) else v for k,v in item['metrics'].items()
+                       if k in ['barrierHits','railHits','maxImpactImpulse','maxBarrierPenetration','maxBeyondBarrier','nonFiniteSteps']})
+            assert not errors,errors
+            assert len(report)==5,report
+            assert all(x['pass'] for x in report),[(x['scenario'],[c for c in x['checks'] if not c['passed']]) for x in report]
+            print('PASS: REAL WebGL / Rapier v1.8.7 browser acceptance')
+        except Exception as exc:
+            page.screenshot(path=str(out/'v187_browser_failure.png'))
+            (out/'v187_errors.json').write_text(json.dumps({'error':str(exc),'pageErrors':errors,
+                'status':page.locator('#status').inner_text() if page.locator('#status').count() else None},ensure_ascii=False,indent=2))
+            raise
+        finally:browser.close()
+
+if __name__=='__main__':main()
