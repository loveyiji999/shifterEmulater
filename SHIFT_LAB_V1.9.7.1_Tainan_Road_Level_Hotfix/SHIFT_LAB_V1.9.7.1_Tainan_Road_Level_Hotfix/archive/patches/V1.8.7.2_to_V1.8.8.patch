+  call npm install --no-audit --no-fund
+  if errorlevel 1 (pause & exit /b 1)
+)
+call npm run build
+if errorlevel 1 (echo Web build failed. & pause & exit /b 1)
+echo Done. Publish the contents of desktop3d\dist\ to a static HTTPS website.
+pause
