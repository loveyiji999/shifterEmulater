+@echo off
+setlocal
+cd /d "%~dp0.."
+for %%F in (desktop3d\tests\validate-*.mjs) do (
+  node "%%F"
+  if errorlevel 1 exit /b 1
+)
+for %%F in (tests\test_v*.py) do (
+  echo ==== %%~nxF ====
+  python -m unittest discover -s tests -p "%%~nxF" -v
+  if errorlevel 1 exit /b 1
