+#!/bin/sh
+# Source / legacy-browser regressions. The true Rapier WASM test is separate.
+set -eu
+cd "$(dirname "$0")/.."
+for test in desktop3d/tests/validate-*.mjs; do node "$test"; done
+for test in tests/test_v*.py; do
+  echo "=== $(basename "$test") ==="
+  python -m unittest discover -s tests -p "$(basename "$test")" -v
+done
+echo "PASS: source + legacy iframe QA. Run desktop3d/tests/browser_v1892.py for REAL WASM/WebGL acceptance."
